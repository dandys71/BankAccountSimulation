# Vývojové hodnoty pro kořenový docker compose. Zkopírujte do .env:
#   copy .env.example .env

JWT_SECRET=dev-secret-change-me

# AuthManager (MongoDB)
MONGO_URI=mongodb://mongo:27017/auth_manager

# TransactionManager (PostgreSQL)
POSTGRES_USER=transaction_user
POSTGRES_PASSWORD=transaction_dev_password
POSTGRES_DB=transaction_manager
DATABASE_URL=postgres://transaction_user:transaction_dev_password@postgres:5432/transaction_manager
